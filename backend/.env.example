# Local development (npm run dev) against `docker compose up -d postgres minio`
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/study_materials

JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1d

S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=materials
