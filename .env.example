# Used by docker-compose.yml. Copy to .env and change the secrets on the server.

# Port the site is published on
WEB_PORT=8080
# Public origin of the site (comma-separated if several)
CORS_ORIGIN=http://localhost:8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=study_materials

# At least 16 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=1d

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=materials
